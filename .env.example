# ==============================================================================
# CivicPulse Environment Configuration (.env.example)
# Copy to .env and configure for local development or deployment
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civicpulse
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Cache Configuration (Redis)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# LLM Triage Provider & Keys
# Options: "simulated" | "llm" | "ollama" | "hybrid"
TRIAGE_PROVIDER=ollama
OPENROUTER_API_KEY=
TRIAGE_LLM_MODEL=google/gemma-4-26b-a4b-it:free
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Application Ports
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Production Image Tag
IMAGE_TAG=latest
